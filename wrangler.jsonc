{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuponlab-v55",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": [
      "5 * * * *",
      "20 */2 * * *",
      "50 2 * * *",
      "35 3 * * *",
      "20 4 * * *"
    ]
  }
}
